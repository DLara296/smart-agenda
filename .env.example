# Local development template. Copy to a root .env file (ignored by Git); never put real secrets in this template.
NODE_ENV=development
PORT=3030
DATABASE_URL=./data/smartagenda.sqlite
# For managed PostgreSQL, replace DATABASE_URL and require TLS outside trusted local/CI environments.
# DATABASE_URL=postgresql://user:password@host:5432/smartagenda
PGSSLMODE=disable
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
# CI only; never point this at staging or production.
POSTGRES_TEST_DATABASE_URL=

# Production requires a random value of at least 32 characters and controlled initial-admin credentials.
# Supply real values through the deployment secret manager, never this file.
SESSION_SECRET=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional local-development admin overrides. These are ignored by production bootstrap.
SMARTAGENDA_ADMIN_EMAIL=admin@smartagenda.local
SMARTAGENDA_ADMIN_PASSWORD=SmartAgendaAdmin2026!

SESSION_REMINDER_LEAD_HOURS=24
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_PROVIDER=sandbox
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
INVITATION_RATE_LIMIT_WINDOW_MS=3600000
INVITATION_RATE_LIMIT_MAX=30

# Email sending stays disabled unless all Gmail OAuth2 values are supplied.
# OAuth consent must grant https://www.googleapis.com/auth/gmail.send (send-only).
# Configure and verify a Google Cloud OAuth consent screen and web/server OAuth client.
# External production use may require Google's app verification; testing-mode refresh tokens may expire.
# Keep client secret and refresh token in a secret manager in deployed environments.
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
