# Local development template. Copy to a root .env file (ignored by Git); never put real secrets in this template.
NODE_ENV=development
PORT=3030
DATABASE_URL=./data/smartagenda.sqlite
SESSION_REMINDER_LEAD_HOURS=24
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5

# Email sending stays disabled unless all Gmail OAuth2 values are supplied.
# OAuth consent must grant https://www.googleapis.com/auth/gmail.send (send-only).
# Configure and verify a Google Cloud OAuth consent screen and web/server OAuth client.
# External production use may require Google's app verification; testing-mode refresh tokens may expire.
# Keep client secret and refresh token in a secret manager in deployed environments.
GMAIL_SENDER_EMAIL=
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=
