{
  "name": "backend",
  "version": "1.0.0",
  "description": "Smart Agenda Node.js backend",
  "main": "src/index.js",
  "scripts": {
    "start": "nodemon src/index.js",
    "start:production": "node src/index.js",
    "test": "jest --detectOpenHandles",
    "test:postgres": "jest --detectOpenHandles --runInBand __tests__/integration/postgres-database.test.js",
    "check:database-boundary": "node scripts/check-database-boundary.js",
    "db:status": "node src/db/migrate.js status",
    "db:migrate": "node src/db/migrate.js up",
    "db:recover": "node src/db/migrate.js recover"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^10.0.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^182.0.0",
    "helmet": "^8.3.0",
    "morgan": "^1.10.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
